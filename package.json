{
  "name": "banal-ai",
  "version": "1.0.5",
  "description": "Banal — curated free AI and developer tools with honest access labels. Static, forkable, bilingual (EN/JA). For builders who fund their own stack.",
  "type": "module",
  "license": "MIT",
  "author": "sakurablush",
  "homepage": "https://sakurablush.github.io/banal/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakurablush/banal.git"
  },
  "bugs": {
    "url": "https://github.com/sakurablush/banal/issues"
  },
  "keywords": [
    "ai",
    "free",
    "equalizer",
    "builders",
    "banal",
    "simple",
    "web",
    "static",
    "i18n",
    "japanese",
    "open-source"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts,.js --fix",
    "lint:check": "eslint src tests --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,js,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,html,css,json,md}\"",
    "ci": "npm run lint:check && npm run format:check && npm run typecheck && npm run test:run && npm audit --audit-level=moderate",
    "verify:tools": "npx tsx scripts/verify-tools.ts",
    "generate:tools-readme": "npx tsx scripts/generate-tools-readme.ts",
    "check:articles": "node scripts/check-articles.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "semver": "^7.5.4",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "word-wrap": "^1.2.5",
    "tough-cookie": "^4.1.3",
    "undici": "^6.27.0",
    "form-data": "^4.0.6",
    "cross-spawn": "^7.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "three": "^0.186.0"
  }
}
